# Copy this file to .env and replace each value with an absolute local path.
# .env is ignored by Git.

# Existing public datasets may live outside this repository and outside the
# generated-dataset root.
CSS_IMAGENET_ROOT=/absolute/path/to/ImageNet
CSS_WIKIART_ROOT=/absolute/path/to/WikiArt
CSS_MODEL_VS_HUMAN_ROOT=/absolute/path/to/model_vs_human

# Generated datasets and experiment outputs.
CSS_DATASETS_ROOT=/absolute/path/to/generated-datasets
CSS_RESULTS_ROOT=/absolute/path/to/results
CSS_CACHE_ROOT=/absolute/path/to/cache
CSS_MODELS_ROOT=/absolute/path/to/models
CSS_SCORES_ROOT=/absolute/path/to/scores
